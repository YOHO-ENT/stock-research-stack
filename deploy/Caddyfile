{
	auto_https off
}

(research_stack_routes) {
	redir /market /market/
	handle_path /market/api/* {
		reverse_proxy market-data-lab-api:8010
	}
	handle_path /market/* {
		reverse_proxy market-data-lab-ui:80
	}

	handle /firn/api/* {
		uri strip_prefix /firn
		reverse_proxy firn-api:8000
	}
	handle /firn {
		reverse_proxy firn-ui:3000
	}
	handle /firn/* {
		reverse_proxy firn-ui:3000
	}

	redir /agents /agents/
	handle /agents/api/* {
		uri strip_prefix /agents
		reverse_proxy tradingagents-api:8002
	}
	handle_path /agents/* {
		reverse_proxy tradingagents-ui:80
	}

	redir /brief /brief/

	handle_path /brief/* {
		root * /srv/dailybrief-reports
		file_server
	}

	reverse_proxy research-hub:3030
}

:80 {
	encode gzip
	basic_auth {
		{$HUB_AUTH_USER} {$HUB_AUTH_HASH}
	}
	import research_stack_routes
}

:8080 {
	encode gzip
	import research_stack_routes
}

