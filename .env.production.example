# research-stack IP-only production deployment example.
# Copy to .env on the server if you need to override docker-compose defaults.
# Do not commit real secrets.

RESEARCH_HUB_HOST=0.0.0.0
RESEARCH_HUB_PORT=3030
RESEARCH_HUB_HEALTH_TIMEOUT_SECONDS=2.5
RESEARCH_HUB_HEALTH_CHECK_URL=http://127.0.0.1:3030/api/services
RESEARCH_HUB_CATALOG_MODE=production
RESEARCH_HUB_PUBLIC_URL=http://149.28.156.116

DAILYBRIEF_PUBLIC_REPORTS_URL=http://149.28.156.116/brief/
DAILYBRIEF_REPORTS_HEALTH_CHECK_URL=http://caddy:8080/brief/health.json

MARKET_DATA_LAB_API_PUBLIC_URL=http://149.28.156.116/market/api/
MARKET_DATA_LAB_API_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/market/api/health
MARKET_DATA_LAB_UI_PUBLIC_URL=http://149.28.156.116/market/
MARKET_DATA_LAB_UI_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/market/

FIRN_API_PUBLIC_URL=http://149.28.156.116/firn/api/
FIRN_API_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/firn/api/health
FIRN_UI_PUBLIC_URL=http://149.28.156.116/firn/
FIRN_UI_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/firn/

TRADINGAGENTS_API_PUBLIC_URL=http://149.28.156.116/agents/api/
TRADINGAGENTS_API_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/agents/health
TRADINGAGENTS_UI_PUBLIC_URL=http://149.28.156.116/agents/
TRADINGAGENTS_UI_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/agents/

MOOMOO_ACCOUNT_WEB_PUBLIC_URL=http://149.28.156.116/moomoo/
MOOMOO_ACCOUNT_WEB_PUBLIC_HEALTH_CHECK_URL=http://caddy:8080/moomoo/api/watchlists/status

# Private deployment values. The real hash is generated by
# scripts/deploy_vultr.sh and stored only in the server .env file.
HUB_AUTH_USER=admin
HUB_AUTH_HASH=

# Sibling repository source paths on the VPS. scripts/deploy_vultr.sh keeps
# these repos updated before docker compose builds.
MARKET_DATA_LAB_DIR=/opt/market-data-lab
FIRN_DIR=/opt/Firn
TRADINGAGENTS_DIR=/opt/TradingAgents
PY_MOOMOO_API_DIR=/opt/py-moomoo-api

# Private service secrets. Keep real values only on the VPS .env.
FIRN_JWT_SECRET=
FIRN_ADMIN_PASSWORD=
FIRN_WATCHLIST_EDITABLE=true
FIRN_LLM_PROVIDER=
FIRN_DEEPSEEK_API_KEY=
FIRN_OPENAI_API_KEY=
FIRN_GEMINI_API_KEY=
FIRN_TAVILY_API_KEY=

TRADINGAGENTS_LLM_PROVIDER=
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_OPENAI_API_KEY=
TRADINGAGENTS_ANTHROPIC_API_KEY=
TRADINGAGENTS_GOOGLE_API_KEY=
TRADINGAGENTS_FINNHUB_API_KEY=

# Highest-risk boundary. Keep OpenD local/private by default.
MOOMOO_ACCOUNT_WEB_ALLOW_REMOTE=0
MOOMOO_EXPORT_HOST=127.0.0.1
MOOMOO_EXPORT_PORT=11111
MOOMOO_EXPORT_MARKET=US
MOOMOO_EXPORT_GROUP_TYPE=CUSTOM

# Current IP-only deployment values.
SSH_TARGET=root@149.28.156.116
SSH_KEY=~/.ssh/research_stack_vultr
